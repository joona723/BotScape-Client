<script>
const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const WIKI = "https://oldschool.runescape.wiki/images/";
const wikiFile = name => WIKI + encodeURIComponent(name.replace(/ /g, "_")) + ".png";
// The wiki names the Runecrafting icon "Runecraft_icon".
const skillIcon = skill => wikiFile((skill === "runecrafting" ? "Runecraft" : skill[0].toUpperCase() + skill.slice(1)) + "_icon");
const COLORS = ["#5fb3f0", "#3fb96b", "#d77ee8", "#ef8a3c", "#4fc1b9", "#e8d27a", "#f07f9a"];
const SKILLS = ["attack","hitpoints","mining","strength","agility","smithing","defence","herblore","fishing",
  "ranged","thieving","cooking","prayer","crafting","firemaking","magic","fletching","woodcutting",
  "runecrafting","slayer","farming","construction","hunter"];

let data = null, selected = null, view = "scripts", outputAfter = 0, outputFilter = null, colors = {};
const lines = [];

function colorFor(name) {
  if (data && name === data.main) return "#e0a83a";
  if (!colors[name]) colors[name] = COLORS[Object.keys(colors).length % COLORS.length];
  return colors[name];
}
function toast(text) {
  const t = $("toast"); t.textContent = text; t.classList.add("show");
  clearTimeout(toast.t); toast.t = setTimeout(() => t.classList.remove("show"), 2600);
}
async function post(action, body = {}) {
  const res = await fetch("/api/" + action, { method: "POST", body: JSON.stringify(body) });
  const out = await res.json().catch(() => ({}));
  if (out.error) toast(out.error);
  setTimeout(refresh, 300);
  return out;
}
function elapsed(started) {
  const s = Math.max(0, Math.floor(Date.now() / 1000 - started));
  return `${Math.floor(s / 3600)}:${String(Math.floor(s / 60) % 60).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;
}
function xpFor(level) {
  let points = 0;
  for (let l = 1; l < level; l++) points += Math.floor(l + 300 * Math.pow(2, l / 7));
  return Math.floor(points / 4);
}
function fmtCount(n) {
  if (n >= 10_000_000) return [Math.floor(n / 1e6) + "M", "m"];
  if (n >= 100_000) return [Math.floor(n / 1e3) + "K", "k"];
  return [n.toLocaleString(), ""];
}

// --- team ---------------------------------------------------------------------------------------
function renderTeam() {
  const team = $("team");
  const chars = data.characters || [];
  if (!selected || !chars.find(c => c.name === selected)) selected = data.main;
  $("teamCount").textContent = `${chars.filter(c => c.status === "online").length} online`;
  team.innerHTML = chars.map(c => {
    const hpPct = c.maxHp ? Math.round(100 * c.hp / c.maxHp) : 0;
    const status = c.status === "logging_in" ? "online" : c.status;
    return `<div class="char ${c.name === selected ? "selected" : ""} ${c.unlocked ? "" : "locked"}" data-name="${esc(c.name)}">
      <div class="top">
        <div class="avatar" style="background:${colorFor(c.name)}">${esc(c.name[0].toUpperCase())}
          <span class="status ${esc(status)}"></span></div>
        <div style="min-width:0;flex:1">
          <div style="display:flex;align-items:center;gap:6px"><span class="name">${esc(c.name)}</span>
            <span class="chip ${c.role === "main" ? "main" : ""}">${esc(c.role)}</span></div>
          <div class="meta">${c.unlocked ? esc(c.status === "online" ? (c.x ? `${c.x}, ${c.z}` : "online") : c.status) : "locked"}</div>
        </div>
        <button class="icon-btn more" data-more="${esc(c.name)}" title="More (or right-click the card)"><span class="more-dots">⋯</span></button>
        ${c.unlocked ? `<button class="icon-btn" data-play="${esc(c.name)}" title="Play ${esc(c.name)} in the client"><img src="/open-client-24.png" alt=""></button>` : ""}
      </div>
      ${c.activity ? `<div class="doing" title="${esc(c.activity)}">${esc(c.activity)}</div>` : ""}
      ${c.maxHp ? `<div class="stats"><div class="bar"><div style="width:${hpPct}%;background:${hpPct < 35 ? "#e05a52" : "#3fb96b"}"></div></div>
        <span>HP ${c.hp}/${c.maxHp} · Total ${c.total}</span></div>` : ""}
      ${c.script ? `<div class="running"><img src="/play-16.png" alt="" width="12">${esc(c.script)}
        <span class="time" data-started="${c.started}">${elapsed(c.started)}</span>
        <button class="icon-btn" data-stop="${esc(c.name)}" title="Stop" style="width:24px;height:24px"><img src="/stop-16.png" alt="" style="width:12px;height:12px"></button></div>` : ""}
    </div>`;
  }).join("") || `<div class="empty"><h3>No characters yet</h3></div>`;
  team.querySelectorAll(".char").forEach(el => el.onclick = e => {
    if (e.target.closest("[data-play],[data-stop],[data-more]")) return;
    selected = skillsWho = el.dataset.name; renderTeam(); renderScripts(); renderSkills();
  });
  team.querySelectorAll("[data-play]").forEach(el => el.onclick = () => post("client", { character: el.dataset.play }));
  const charByName = name => (data.characters || []).find(c => c.name === name);
  team.querySelectorAll(".char").forEach(el => el.oncontextmenu = e => {
    e.preventDefault();
    const c = charByName(el.dataset.name); if (c) openMenu(characterMenu(c), e.clientX, e.clientY);
  });
  team.querySelectorAll("[data-more]").forEach(el => el.onclick = () => {
    const c = charByName(el.dataset.more); if (!c) return;
    const r = el.getBoundingClientRect();
    openMenu(characterMenu(c), r.left, r.bottom + 4);
    el.classList.add("open");
  });
  team.querySelectorAll("[data-stop]").forEach(el => el.onclick = () => post("stop", { character: el.dataset.stop }));

  const f = data.family || {};
  const total = f.totalLevel || 0, next = f.nextUnlockAt || 100, prev = next - 100;
  const pct = Math.max(0, Math.min(100, (total - prev)));
  const clones = (f.clones || []).length, unlocked = f.unlocked || 0;
  $("cloneCard").innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:baseline">
      <div><div class="hint">Family total level</div><div class="big">${total}</div></div>
      <div style="text-align:right"><div class="hint">Clones</div><div class="big" style="color:var(--text)">${clones}<span class="hint"> / ${unlocked}</span></div></div>
    </div>
    <div class="bar" style="margin:10px 0 6px"><div style="width:${pct}%;background:var(--gold)"></div></div>
    <div class="hint">Next clone at total level ${next} · ${Math.max(0, next - total)} to go</div>
    <div style="display:flex;gap:8px;margin-top:12px;align-items:center">
      <button class="btn gold small" id="newClone" ${clones < unlocked ? "" : "disabled"}><img src="/clone-16.png" alt="" style="filter:brightness(0)">New clone</button>
      <div class="toggle ${data.autoClone ? "on" : ""}" id="autoClone"><span class="switch"></span>Auto</div>
    </div>`;
  $("newClone").onclick = () => {
    const name = prompt("Name for the new clone (max 12 letters):");
    if (name) post("clone", { name }).then(r => r.ok && toast(`Clone ${name} made`));
  };
  $("autoClone").onclick = () => post("settings", { auto_clone: !data.autoClone });
}

// --- scripts ------------------------------------------------------------------------------------
function renderScripts() {
  const q = $("search").value.trim().toLowerCase();
  const sel = (data.characters || []).find(c => c.name === selected);
  $("scriptHint").innerHTML = sel ? `Runs on <b style="color:${colorFor(sel.name)}">${esc(sel.name)}</b>` : "";
  const scripts = (data.scripts || []).filter(s => (!q || s.name.toLowerCase().includes(q) || s.description.toLowerCase().includes(q))
    && (!category || categoryOf(s) === category));
  const card = s => {
    const running = sel && sel.script === s.name;
    const icon = s.skill && SKILLS.includes(s.skill) ? `<img src="${skillIcon(s.skill)}" alt="" onerror="this.src='/scripts-24.png'">`
      : `<img src="/scripts-24.png" alt="">`;
    return `<div class="script ${running ? "is-running" : ""}" data-script="${esc(s.id)}">
      <div class="head"><div class="badge">${icon}</div><div class="title">${esc(s.name)}</div></div>
      <div class="desc">${esc(s.description || "No description.")}</div>
      <div class="row">
        ${running ? `<button class="stop-btn" data-stop="${esc(selected)}"><img src="/stop-16.png" alt="">Stop</button>`
                  : `<button class="run-btn" data-run="${esc(s.id)}"><img src="/play-16.png" alt="">Run on ${esc(selected || "")}</button>`}
        <button class="btn small" data-team="${esc(s.id)}" title="Run on every unlocked character">Run on team</button>
      </div></div>`;
  };
  const packaged = scripts.filter(s => s.source === "botscape"), own = scripts.filter(s => s.source !== "botscape");
  const ownTotal = (data.scripts || []).filter(s => s.source !== "botscape").length;
  let html = `<div class="section-head"><h3>Bot Scape scripts</h3><span class="count">${packaged.length}</span>
    <span class="sub">Included with the game and kept up to date.</span></div>`;
  html += packaged.length ? packaged.map(card).join("") : `<div class="section-empty">${q ? "No Bot Scape scripts match." : "No scripts installed."}</div>`;
  html += `<div class="section-head"><h3>My scripts</h3><span class="count">${own.length}</span>
    <span class="sub">Your own .py scripts, in your scripts folder.</span>
    <button class="btn small" id="ownFolder"><img src="/open-client-16.png" alt="">Open folder</button></div>`;
  html += own.length ? own.map(card).join("") : `<div class="section-empty">${q && ownTotal ? "None of your scripts match."
    : "No scripts of your own yet. Put a .py file in your scripts folder (start from <b>MyFirstScript.py</b>) and it shows up here."}</div>`;
  $("scripts").innerHTML = html;
  $("ownFolder").onclick = () => post("folder", {});
  $("scripts").querySelectorAll("[data-run]").forEach(el => el.onclick = () => runScript(selected, el.dataset.run));
  $("scripts").querySelectorAll("[data-stop]").forEach(el => el.onclick = () => post("stop", { character: el.dataset.stop }));
  $("scripts").querySelectorAll("[data-team]").forEach(el => el.onclick = () => post("run-team", { script: el.dataset.team }));
  $("scripts").querySelectorAll("[data-script]").forEach(el => el.oncontextmenu = e => {
    e.preventDefault();
    const s = (data.scripts || []).find(x => x.id === el.dataset.script); if (s) openMenu(scriptCardMenu(s), e.clientX, e.clientY);
  });
}

// --- script categories --------------------------------------------------------------------------
const CATEGORIES = [
  ["gathering", "Gathering", ["mining", "woodcutting", "fishing", "hunter", "farming"]],
  ["production", "Production", ["cooking", "crafting", "firemaking", "fletching", "herblore", "smithing",
    "runecrafting", "construction"]],
  ["combat", "Combat", ["attack", "strength", "defence", "ranged", "magic", "prayer", "hitpoints", "slayer"]],
  ["support", "Support", ["agility", "thieving"]],
  ["utility", "Utility", []],
];
const categoryOf = s => (CATEGORIES.find(([, , skills]) => skills.includes(s.skill)) || CATEGORIES[4])[0];
let category = "";
function renderCats() {
  $("cats").innerHTML = [["", "All"], ...CATEGORIES.map(([id, label]) => [id, label])]
    .map(([id, label]) => `<button class="filter ${category === id ? "on" : ""}" data-cat="${id}">${label}</button>`).join("");
  $("cats").querySelectorAll("[data-cat]").forEach(b => b.onclick = () => { category = b.dataset.cat; renderCats(); renderScripts(); });
}
function scriptIcon(s) {
  return s.skill && SKILLS.includes(s.skill) ? `<img src="${skillIcon(s.skill)}" alt="" onerror="this.src='/scripts-16.png'">`
    : `<img src="/scripts-16.png" alt="">`;
}
function avatarHtml(c) {
  const status = c.status === "logging_in" ? "online" : c.status;
  return `<div class="avatar" style="background:${colorFor(c.name)}">${esc(c.name[0].toUpperCase())}<span class="status ${esc(status)}"></span></div>`;
}
// Scripts a character ran lately (this computer only), newest first.
function recentScripts(name) {
  try { return JSON.parse(localStorage.getItem("recent:" + name) || "[]"); } catch (e) { return []; }
}
function runScript(name, id) {
  try {
    localStorage.setItem("recent:" + name, JSON.stringify([id, ...recentScripts(name).filter(r => r !== id)].slice(0, 3)));
  } catch (e) {}
  return post("run", { character: name, script: id });
}

// --- right-click menus --------------------------------------------------------------------------
// An item: { label, icon, cls, kbd, disabled, run(), sub() -> items, search: true (on a submenu list) },
// or { sep: true }, { title }, { html }.
const menus = [];
function closeMenus(depth = 0) {
  while (menus.length > depth) menus.pop().remove();
  document.querySelectorAll(".more.open").forEach(b => b.classList.remove("open"));
}
function openMenu(items, x, y, depth = 0, anchor = null) {
  closeMenus(depth);
  const el = document.createElement("div");
  el.className = "ctx";
  el.tabIndex = -1;
  document.body.appendChild(el);
  menus.push(el);
  const fill = list => {
    const scroll = el.querySelector(".ctx-scroll") || el;
    scroll.innerHTML = "";
    for (const it of list) {
      if (it.sep) { scroll.insertAdjacentHTML("beforeend", `<div class="ctx-sep"></div>`); continue; }
      if (it.title) { scroll.insertAdjacentHTML("beforeend", `<div class="ctx-label">${esc(it.title)}</div>`); continue; }
      if (it.html) { scroll.insertAdjacentHTML("beforeend", it.html); continue; }
      const b = document.createElement("button");
      b.className = "ctx-item " + (it.cls || "");
      b.disabled = !!it.disabled;
      b.innerHTML = `<span class="ico">${it.icon || ""}</span><span class="label">${esc(it.label)}</span>`
        + (it.kbd ? `<span class="kbd">${esc(it.kbd)}</span>` : "") + (it.sub ? `<span class="arrow">▶</span>` : "");
      if (it.sub) {
        const open = () => {
          if (b.classList.contains("open")) return;
          el.querySelectorAll(".ctx-item.open").forEach(o => o.classList.remove("open"));
          b.classList.add("open");
          const r = b.getBoundingClientRect();
          openMenu(it.sub(), r.right + 2, r.top - 6, depth + 1, r);
        };
        b.onmouseenter = open; b.onclick = open; b.openSub = open;
      } else {
        b.onmouseenter = () => { closeMenus(depth + 1); el.querySelectorAll(".ctx-item.open").forEach(o => o.classList.remove("open")); };
        b.onclick = () => { closeMenus(); it.run && it.run(); };
      }
      scroll.appendChild(b);
    }
    if (!scroll.querySelector(".ctx-item")) scroll.insertAdjacentHTML("beforeend", `<div class="ctx-none">Nothing matches.</div>`);
  };
  if (items.search) {
    el.innerHTML = `<input class="ctx-search" placeholder="Type to filter…"><div class="ctx-scroll"></div>`;
    const input = el.querySelector("input");
    input.oninput = () => {
      const q = input.value.trim().toLowerCase();
      // Keep a section title only when one of its items matches.
      const out = [];
      let pendingTitle = null;
      for (const it of items) {
        if (it.title) { pendingTitle = it; continue; }
        if (it.sep || (q && !it.label.toLowerCase().includes(q))) continue;
        if (pendingTitle) { out.push(pendingTitle); pendingTitle = null; }
        out.push(it);
      }
      fill(out);
    };
    input.onkeydown = e => { if (e.key === "Enter") { const first = el.querySelector(".ctx-item:not(:disabled)"); first && first.click(); } };
    fill(items);
    setTimeout(() => input.focus(), 0);
  } else {
    fill(items);
    setTimeout(() => el.focus(), 0);
  }
  // Keep it on screen: flip a submenu to the left of its parent, push a menu up from the bottom edge.
  const w = el.offsetWidth, h = el.offsetHeight;
  if (x + w > innerWidth - 8) x = anchor ? anchor.left - w - 2 : innerWidth - w - 8;
  if (y + h > innerHeight - 8) y = Math.max(8, innerHeight - h - 8);
  el.style.left = Math.max(8, x) + "px"; el.style.top = y + "px";
  requestAnimationFrame(() => el.classList.add("show"));
  return el;
}
document.addEventListener("mousedown", e => { if (!e.target.closest(".ctx, .more")) closeMenus(); });
window.addEventListener("resize", () => closeMenus());
document.addEventListener("keydown", e => {
  if (!menus.length) return;
  const top = menus[menus.length - 1];
  const items = [...top.querySelectorAll(".ctx-item:not(:disabled)")];
  const i = items.indexOf(document.activeElement);
  if (e.key === "Escape") { e.preventDefault(); closeMenus(menus.length - 1); menus.length && menus[menus.length - 1].focus(); }
  else if (e.key === "ArrowDown" || e.key === "ArrowUp") {
    e.preventDefault();
    const next = i < 0 ? items[e.key === "ArrowDown" ? 0 : items.length - 1]
      : items[(i + (e.key === "ArrowDown" ? 1 : items.length - 1)) % items.length];
    next && next.focus();
  } else if (e.key === "ArrowRight" && document.activeElement?.openSub) { e.preventDefault(); document.activeElement.openSub(); }
  else if (e.key === "ArrowLeft" && menus.length > 1) {
    e.preventDefault(); closeMenus(menus.length - 1);
    const parent = menus[menus.length - 1].querySelector(".ctx-item.open");
    parent && (parent.classList.remove("open"), parent.focus());
  }
});

function scriptMenuItems(c) {
  const scripts = data.scripts || [];
  const item = s => ({ label: s.name, icon: scriptIcon(s), cls: c.script === s.name ? "running" : "",
                       run: () => runScript(c.name, s.id) });
  const out = [];
  for (const [id, label] of CATEGORIES) {
    const list = scripts.filter(s => s.source === "botscape" && categoryOf(s) === id);
    if (list.length) out.push({ title: label }, ...list.map(item));
  }
  const own = scripts.filter(s => s.source !== "botscape");
  if (own.length) out.push({ title: "My scripts" }, ...own.map(item));
  out.search = true;
  return out;
}
function characterMenu(c) {
  const online = c.status === "online" || c.status === "logging_in";
  const statusText = c.unlocked ? (c.script ? `${online ? "Online" : c.status} · running ${c.script}` : (online ? "Online" : c.status)) : "Locked";
  const items = [
    { html: `<div class="ctx-head">${avatarHtml(c)}<div><b>${esc(c.name)}</b><span>${esc(c.role)} · ${esc(statusText)}</span></div></div>` },
    { label: `Open client as ${c.name}`, icon: `<img src="/open-client-16.png" alt="">`, cls: "gold", disabled: !c.unlocked,
      run: () => post("client", { character: c.name }) },
    { label: "Run script", icon: `<img src="/scripts-16.png" alt="">`, disabled: !c.unlocked, sub: () => scriptMenuItems(c) },
  ];
  const recent = recentScripts(c.name).map(id => (data.scripts || []).find(s => s.id === id)).filter(Boolean);
  if (c.unlocked && recent.length) {
    items.push({ title: "Run again" },
      ...recent.map(s => ({ label: s.name, icon: scriptIcon(s), cls: c.script === s.name ? "running" : "green",
                            run: () => runScript(c.name, s.id) })));
  }
  if (c.script) {
    items.push({ sep: true },
      { label: `Stop ${c.script}`, icon: `<img src="/stop-16.png" alt="">`, cls: "red", run: () => post("stop", { character: c.name }) });
  }
  items.push({ sep: true },
    { label: "Show on live map", icon: `<img src="/map-16.png" alt="">`, disabled: !online, run: () => showOnMap(c.name) },
    { label: "Show output", icon: `<span class="more-dots" style="font-size:13px">≡</span>`, run: () => showOutput(c.name) },
    { label: "Copy name", icon: `<span class="more-dots" style="font-size:13px">⧉</span>`,
      run: () => navigator.clipboard.writeText(c.name).then(() => toast("Copied " + c.name), () => toast(c.name)) });
  if (online) {
    items.push({ sep: true }, { label: "Log out", icon: `<img src="/stop-16.png" alt="">`, cls: "red",
      run: () => post("logout", { character: c.name }).then(r => r.ok && toast(`${c.name} logged out`)) });
  }
  return items;
}
function scriptCardMenu(s) {
  const chars = (data.characters || []).filter(c => c.unlocked);
  const items = [{ html: `<div class="ctx-head"><div class="badge" style="width:28px;height:28px">${scriptIcon(s)}</div>
      <div><b>${esc(s.name)}</b><span>${s.source === "botscape" ? "Bot Scape script" : "My script"}</span></div></div>` },
    { title: "Run on" },
    ...chars.map(c => ({ label: c.name, cls: c.script === s.name ? "running" : "",
      icon: `<span style="width:10px;height:10px;border-radius:50%;background:${colorFor(c.name)}"></span>`,
      kbd: c.script && c.script !== s.name ? c.script : "", run: () => runScript(c.name, s.id) })),
    { label: "Whole team", icon: `<img src="/family-16.png" alt="">`, cls: "green", run: () => post("run-team", { script: s.id }) }];
  const running = chars.filter(c => c.script === s.name);
  if (running.length) {
    items.push({ sep: true }, ...running.map(c => ({ label: `Stop on ${c.name}`, icon: `<img src="/stop-16.png" alt="">`, cls: "red",
      run: () => post("stop", { character: c.name }) })));
  }
  return items;
}
function switchView(name) { document.querySelector(`.tab[data-view="${name}"]`).click(); }
function showOnMap(name) {
  switchView("map");
  const frame = $("mapFrame");
  // The map may still be loading the first time; ask again once it has the players.
  const send = () => frame.contentWindow && frame.contentWindow.postMessage({ follow: name }, "*");
  send(); setTimeout(send, 1200);
}
function showOutput(name) { outputFilter = name; renderFilters(); switchView("output"); }

// --- skills and bank ----------------------------------------------------------------------------
let skillsWho = null;   // a character's name, or "" for the whole family
// The worn-equipment screen: equipment slot numbers laid out like the game's (null = gap).
const WORN = [[null, 0, null], [1, 2, 13], [3, 4, 5], [null, 7, null], [9, 10, 12]];
const SLOT_NAMES = { 0: "Head", 1: "Cape", 2: "Neck", 3: "Weapon", 4: "Body", 5: "Shield", 7: "Legs", 9: "Hands",
  10: "Feet", 12: "Ring", 13: "Ammo" };
const cap = s => s[0].toUpperCase() + s.slice(1);
function fmtShort(n) {
  if (n >= 1e6) return (n / 1e6).toFixed(n >= 1e7 ? 0 : 1) + "M";
  if (n >= 1e3) return (n / 1e3).toFixed(n >= 1e5 ? 0 : 1) + "k";
  return String(n);
}
function fmtDuration(sec) {
  if (!isFinite(sec) || sec <= 0) return "";
  if (sec < 60) return "<1m";
  const m = Math.floor(sec / 60), h = Math.floor(m / 60), d = Math.floor(h / 24);
  if (d) return `${d}d ${h % 24}h`;
  if (h) return `${h}h ${String(m % 60).padStart(2, "0")}m`;
  return `${m}m`;
}
// The wiki draws coins by pile size and other stackables (arrows, runes) as "<name> 5".
const COIN_PILES = [10000, 1000, 250, 100, 25, 5, 4, 3, 2, 1];
function itemImg(name, count = 1) {
  if (name === "Coins") return `<img src="${wikiFile("Coins " + COIN_PILES.find(n => count >= n))}" alt="" onerror="this.style.display='none'">`;
  return `<img src="${esc(wikiFile(name))}" data-alt="${esc(wikiFile(name + " 5"))}" alt=""
    onerror="if (this.dataset.alt) { this.src = this.dataset.alt; this.dataset.alt = ''; } else this.style.display = 'none'">`;
}
function itemSlot(item, empty = "") {
  if (!item) return `<div class="slot">${empty}</div>`;
  const [n, cls] = fmtCount(item.count);
  return `<div class="slot" data-name="${esc(item.name)}${item.count > 1 ? " × " + item.count.toLocaleString() : ""}">
    ${itemImg(item.name, item.count)}
    ${item.count > 1 ? `<span class="n ${cls}">${n}</span>` : ""}</div>`;
}
function renderSkills() {
  const chars = (data.characters || []).filter(c => c.unlocked);
  if (skillsWho === null || (skillsWho && !chars.find(c => c.name === skillsWho))) skillsWho = selected || data.main || "";
  const who = chars.find(c => c.name === skillsWho);
  const stats = (who && who.stats) || data.skills;
  const xp = who ? who.xp : data.familyXp;
  const picker = `<div class="cats">` + [`<button class="filter ${skillsWho ? "" : "on"}" data-who="">Family</button>`]
    .concat(chars.map(c => `<button class="filter ${skillsWho === c.name ? "on" : ""}" data-who="${esc(c.name)}">`
      + `<span class="dot" style="background:${colorFor(c.name)}"></span>${esc(c.name)}</button>`)).join("") + `</div>`;
  if (!stats) {
    $("skills").innerHTML = picker + `<div class="empty"><img src="/ui/empty-offline.svg" onerror="this.remove()" alt=""><h3>No one is online</h3>
      <div>Skills are shared by the whole family; they show while someone plays.</div></div>`;
    bindWho();
    return;
  }
  const online = who && who.stats;
  const tracked = xp ? xp.skills : {};
  const nextIn = (name, s) => {
    const t = tracked[name];
    return t && t.perHour > 0 && s.base < 99 ? fmtDuration((xpFor(s.base + 1) - s.xp) / t.perHour * 3600) : "";
  };

  // Who this is, and the xp tracker's totals.
  let head;
  if (who) {
    head = `<div class="who-card">${avatarHtml(who)}
      <div class="who-main"><b>${esc(who.name)}</b><span>${esc(who.role)} · ${online ? (who.script ? "running " + esc(who.script) : "online") : esc(who.status)}</span></div>
      ${online ? `<div class="kv"><span>Combat</span><b>${who.combat}</b></div><div class="kv"><span>Total</span><b>${who.total}</b></div>
        <div class="kv"><span>Hitpoints</span><b>${who.hp}/${who.maxHp}</b></div>
        <div class="kv"><span>Run</span><b>${who.runEnergy ?? "?"}%</b></div>` : ""}`;
  } else {
    head = `<div class="who-card"><div class="avatar" style="background:var(--gold)"><img src="/family-24.png" alt="" style="width:20px;filter:brightness(0)"></div>
      <div class="who-main"><b>${esc(data.main)}'s family</b><span>${chars.length} character${chars.length === 1 ? "" : "s"} · shared skills and bank</span></div>
      <div class="kv"><span>Total</span><b>${data.family?.totalLevel ?? "?"}</b></div>`;
  }
  head += `<div class="spacer"></div>
    <div class="kv"><span>${xp ? "Tracking " + elapsed(xp.since) : "Tracking"}</span><b>${xp ? fmtShort(xp.gained) + " xp" : "–"}</b></div>
    <div class="kv"><span>XP / hour</span><b class="gold">${xp && xp.perHour ? fmtShort(xp.perHour) : "–"}</b></div>
    <button class="icon-btn" id="xpReset" title="Reset the xp/h counters"><img src="/reload-16.png" alt=""></button></div>`;
  if (xp && !xp.ownXp && who && chars.length > 1) {
    head += `<div class="hint" style="margin:-6px 0 12px">The server doesn't say who earned what yet, so these are the family's shared gains.</div>`;
  }

  // Skills trained this session, most recent first.
  const active = Object.entries(tracked).filter(([n]) => stats[n]).sort((a, b) => (b[1].lastGain || 0) - (a[1].lastGain || 0));
  let training = "";
  if (active.length) {
    training = `<div class="section-head"><h3>Training now</h3><span class="count">${active.length}</span></div><div class="training">` + active.map(([name, t]) => {
      const s = stats[name], lo = xpFor(s.base), hi = xpFor(s.base + 1);
      const pct = s.base >= 99 ? 100 : Math.round(100 * (s.xp - lo) / Math.max(1, hi - lo));
      const fresh = t.lastGain && Date.now() / 1000 - t.lastGain < 30;
      const eta = nextIn(name, s);
      return `<div class="train ${fresh ? "fresh" : ""}">
        <img src="${skillIcon(name)}" alt="">
        <div class="t-main"><div class="t-top"><b>${cap(name)}</b><span class="lvl">${s.base}</span>${s.base < 99 ? `<span class="hint">→ ${s.base + 1}</span>` : ""}
          <span class="spacer"></span><span class="hint">${pct}%</span></div>
          <div class="bar"><div style="width:${pct}%"></div></div>
          <div class="t-stats"><span>+${t.gained.toLocaleString()} xp</span><span><b>${fmtShort(t.perHour)}</b> xp/h</span>
            ${s.base < 99 ? `<span>${(hi - s.xp).toLocaleString()} xp left</span><span>${eta ? `level in <b>${eta}</b>` : ""}</span>` : `<span>Max level</span>`}</div></div></div>`;
    }).join("") + `</div>`;
  }

  // Every skill.
  const grid = `<div class="section-head"><h3>Skills</h3><span class="sub">${online ? "Boosted or drained levels show as current/base." : ""}</span></div>
    <div class="skills">` + SKILLS.map(name => {
    const s = stats[name]; if (!s) return "";
    const lo = xpFor(s.base), hi = xpFor(s.base + 1);
    const pct = s.base >= 99 ? 100 : Math.round(100 * (s.xp - lo) / Math.max(1, hi - lo));
    const t = tracked[name], eta = nextIn(name, s);
    const boosted = online && s.level !== s.base;
    return `<div class="skill ${t ? "trained" : ""}" title="${s.xp.toLocaleString()} xp${s.base < 99 ? ` · ${(hi - s.xp).toLocaleString()} to level ${s.base + 1}` : ""}${t ? ` · ${t.perHour.toLocaleString()} xp/h` : ""}">
      <img src="${skillIcon(name)}" alt=""><div>${cap(name)}${t ? `<div class="rate">${fmtShort(t.perHour)}/h${eta ? " · " + eta : ""}</div>` : ""}</div>
      <div class="lvl">${boosted ? `<span class="${s.level > s.base ? "up" : "down"}">${s.level}</span><span class="of">/${s.base}</span>` : s.base}</div>
      <div class="bar"><div style="width:${pct}%"></div></div></div>`;
  }).join("") + `</div>`;

  // Worn equipment and inventory.
  let side = "";
  if (who && online) {
    const worn = Object.fromEntries((who.equipment || []).map(i => [i.slot, i]));
    const inv = Object.fromEntries((who.inventory || []).map(i => [i.slot, i]));
    side = `<div class="panel"><div class="panel-title">Worn equipment</div><div class="worn">`
      + WORN.flat().map(slot => slot === null ? `<div></div>`
        : itemSlot(worn[slot], `<img class="ph" src="${wikiFile(SLOT_NAMES[slot] + " slot")}" alt="" title="${SLOT_NAMES[slot]}" onerror="this.remove()">`)).join("")
      + `</div></div>
      <div class="panel"><div class="panel-title">Inventory<span>${(who.inventory || []).length}/28</span></div><div class="inv">`
      + Array.from({ length: 28 }, (_, i) => itemSlot(inv[i])).join("") + `</div></div>`;
  } else if (who) {
    side = `<div class="panel"><div class="empty" style="padding:30px 10px"><h3>${esc(who.name)} is offline</h3>
      <div>Inventory and equipment show while ${esc(who.name)} plays.</div></div></div>`;
  }
  $("skills").innerHTML = picker + head
    + `<div class="char-layout ${side ? "" : "no-side"}"><div>${training}${grid}</div>${side ? `<div class="side">${side}</div>` : ""}</div>`;
  bindWho();
  $("xpReset").onclick = () => post("xp-reset", skillsWho ? { character: skillsWho } : {}).then(r => r.ok && toast("XP tracking reset"));
}
function bindWho() {
  $("skills").querySelectorAll("[data-who]").forEach(b => b.onclick = () => { skillsWho = b.dataset.who; renderSkills(); });
}
function renderBank() {
  const bank = data.bank;
  $("bankCount").textContent = bank && bank.length ? bank.length : "";
  if (!bank) {
    $("bank").innerHTML = `<div class="empty"><img src="/ui/empty-offline.svg" onerror="this.remove()" alt=""><h3>No one is online</h3><div>The shared bank shows while someone in the family plays.</div></div>`;
    return;
  }
  if (!bank.length) {
    $("bank").innerHTML = `<div class="empty"><img src="/ui/empty-bank.svg" onerror="this.remove()" alt=""><h3>The bank is empty</h3></div>`;
    return;
  }
  $("bank").innerHTML = `<div class="bank">` + bank.map(i => {
    const [n, cls] = fmtCount(i.count);
    return `<div class="item" data-name="${esc(i.name)} × ${i.count.toLocaleString()}">${itemImg(i.name, i.count)}
      ${i.count > 1 ? `<span class="n ${cls}">${n}</span>` : ""}</div>`;
  }).join("") + `</div>`;
}

// --- output ------------------------------------------------------------------------------------
function renderFilters() {
  const names = (data.characters || []).map(c => c.name);
  $("filters").innerHTML = [`<button class="filter ${outputFilter ? "" : "on"}" data-f="">Everyone</button>`]
    .concat(names.map(n => `<button class="filter ${outputFilter === n ? "on" : ""}" data-f="${esc(n)}">${esc(n)}</button>`)).join("")
    + `<div class="spacer"></div><button class="btn small" id="clearOut">Clear</button>`;
  $("filters").querySelectorAll("[data-f]").forEach(el => el.onclick = () => { outputFilter = el.dataset.f || null; renderFilters(); renderConsole(); });
  $("clearOut").onclick = () => { lines.length = 0; renderConsole(); };
}
function lineHtml(l) {
  return `<span class="t">${l.time} </span>${l.who ? `<span class="w" style="color:${colorFor(l.who)}">${esc(l.who)} </span>` : ""}<span class="${l.kind}">${esc(l.text)}</span>\n`;
}
function renderConsole() {
  const el = $("console");
  el.innerHTML = lines.filter(l => !outputFilter || l.who === outputFilter).map(lineHtml).join("")
    || `<span class="t">Script output shows here.</span>`;
  el.scrollTop = el.scrollHeight;
}
async function pollOutput() {
  try {
    const fresh = await (await fetch("/api/output?after=" + outputAfter)).json();
    if (fresh.length) {
      outputAfter = fresh[fresh.length - 1].id;
      lines.push(...fresh);
      if (lines.length > 4000) lines.splice(0, lines.length - 3000);
      const el = $("console"), atEnd = el.scrollHeight - el.scrollTop - el.clientHeight < 40;
      el.insertAdjacentHTML("beforeend", fresh.filter(l => !outputFilter || l.who === outputFilter).map(lineHtml).join(""));
      if (atEnd) el.scrollTop = el.scrollHeight;
    }
  } catch (e) {}
  setTimeout(pollOutput, 1000);
}

// --- highscores ---------------------------------------------------------------------------------
let hsData = null, hsSkill = null, hsLoaded = 0;
async function loadHiscores() {
  if (Date.now() - hsLoaded < 15000 && hsData) return renderHiscores();
  try { hsData = await (await fetch("/api/hiscores")).json(); hsLoaded = Date.now(); } catch (e) { hsData = { error: "Server offline" }; }
  renderHiscores();
}
function renderHiscores() {
  $("hsSkills").innerHTML = `<button class="${hsSkill ? "" : "on"}" data-s="" title="Overall"><img src="${wikiFile("Stats_icon")}" alt=""></button>`
    + SKILLS.map(s => `<button class="${hsSkill === s ? "on" : ""}" data-s="${s}" title="${s[0].toUpperCase() + s.slice(1)}"><img src="${skillIcon(s)}" alt=""></button>`).join("");
  $("hsSkills").querySelectorAll("[data-s]").forEach(b => b.onclick = () => { hsSkill = b.dataset.s || null; renderHiscores(); });
  if (!hsData || hsData.error) {
    $("hiscores").innerHTML = `<div class="empty"><img src="/ui/empty-offline.svg" onerror="this.remove()" alt=""><h3>Highscores unavailable</h3><div>${esc(hsData?.error || "")}</div></div>`;
    return;
  }
  const me = (data?.main || "").toLowerCase();
  const medal = i => i < 3 ? `<span class="medal">${["🥇","🥈","🥉"][i]}</span>` : i + 1;
  if (!hsSkill) {
    const rows = hsData.overall || [];
    $("hiscores").innerHTML = `<table class="hs"><tr><th>Rank</th><th>Player</th><th>Clones</th><th class="num">Total level</th><th class="num">Total XP</th></tr>`
      + rows.map((r, i) => `<tr class="${r.name.toLowerCase() === me ? "me" : ""}"><td class="rank">${medal(i)}</td><td>${esc(r.name)}</td>
        <td>${r.clones || ""}</td><td class="num">${r.totalLevel.toLocaleString()}</td><td class="num">${r.totalXp.toLocaleString()}</td></tr>`).join("")
      + `</table>` + (rows.length ? "" : `<div class="empty"><h3>No players yet</h3></div>`);
  } else {
    const rows = (hsData.skills || {})[hsSkill] || [];
    $("hiscores").innerHTML = `<table class="hs"><tr><th>Rank</th><th>Player</th><th class="num">Level</th><th class="num">XP</th></tr>`
      + rows.map((r, i) => `<tr class="${r.name.toLowerCase() === me ? "me" : ""}"><td class="rank">${medal(i)}</td><td>${esc(r.name)}</td>
        <td class="num">${r.level}</td><td class="num">${r.xp.toLocaleString()}</td></tr>`).join("")
      + `</table>` + (rows.length ? "" : `<div class="empty"><h3>No one has trained ${esc(hsSkill)} yet</h3></div>`);
  }
}

// --- header, settings, setup -------------------------------------------------------------------
function renderHeader() {
  $("mainName").textContent = data.main ? "· " + data.main : "";
  const pill = $("serverPill");
  pill.className = "pill " + (data.online ? "on" : "off");
  $("serverText").textContent = data.online ? `Server online · ${data.ms} ms` : "Server offline";
  $("clientBtn").innerHTML = `<img src="/play-16.png" alt="" style="filter:brightness(0)">Play ${esc(selected || data.main || "")}`;
  $("serverInput").value ||= data.server || "127.0.0.1";
  $("accountHint").textContent = `Playing as ${data.main}. Scripts live in bots/${data.main}/.`;
  $("autoToggle").className = "toggle " + (data.autoClone ? "on" : "");
  $("setup").classList.toggle("show", data.hasAccount === false);
  $("setupServer").value ||= data.server || "127.0.0.1";
  const frame = $("mapFrame");
  if (view === "map" && data.mapUrl && frame.dataset.src !== data.mapUrl) { frame.src = data.mapUrl; frame.dataset.src = data.mapUrl; }
}

async function refresh() {
  try {
    data = await (await fetch("/api/overview")).json();
  } catch (e) {
    data = { online: false, characters: [], scripts: [] };
  }
  renderHeader();
  if (data.characters) renderTeam();
  renderScripts();
  renderSkills();
  renderBank();
  if (view === "hiscores") loadHiscores();
  if (!$("filters").children.length || $("filters").dataset.n != (data.characters || []).length) {
    $("filters").dataset.n = (data.characters || []).length; renderFilters();
  }
}

$("tabs").onclick = e => {
  const tab = e.target.closest(".tab"); if (!tab) return;
  view = tab.dataset.view;
  document.querySelectorAll(".tab").forEach(t => t.classList.toggle("active", t === tab));
  document.querySelectorAll(".view").forEach(v => v.classList.toggle("active", v.id === "view-" + view));
  if (view === "output") renderConsole();
  if (view === "hiscores") loadHiscores();
  if (data) renderHeader();
};
$("search").oninput = renderScripts;
renderCats();
$("stopAll").onclick = () => post("stop-all");
$("clientBtn").onclick = () => post("client", { character: selected || data.main });
$("folderBtn").onclick = () => post("folder");
$("serverSave").onclick = () => post("settings", { server: $("serverInput").value.trim() }).then(() => toast("Server saved"));
$("autoToggle").onclick = () => post("settings", { auto_clone: !data.autoClone });
$("accountChange").onclick = () => $("setup").classList.add("show");
$("setupGo").onclick = async () => {
  const out = await post("account", { main: $("setupName").value, password: $("setupPass").value });
  if (out.ok) {
    await post("settings", { server: $("setupServer").value.trim() || "127.0.0.1" });
    $("setup").classList.remove("show");
    toast("Welcome! Press ▶ on a script to start.");
  } else {
    $("setupError").textContent = out.error || "Something went wrong.";
  }
};
setInterval(() => document.querySelectorAll("[data-started]").forEach(el => el.textContent = elapsed(+el.dataset.started)), 1000);
// Prefer the Codex brand logo when it exists.
for (const id of ["logo"]) {
  const img = new Image(); img.onload = () => $(id).src = img.src; img.src = "/brand/logo-64.png";
}
refresh().then(() => {
  const tab = document.querySelector(`.tab[data-view="${location.hash.slice(1)}"]`);
  if (tab) tab.click();
});
setInterval(refresh, 1500); pollOutput();
window.addEventListener("beforeunload", e => {
  if ((data?.characters || []).some(c => c.script)) { e.preventDefault(); e.returnValue = ""; }
});
</script>
