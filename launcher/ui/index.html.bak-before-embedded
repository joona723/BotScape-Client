<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bot Scape</title>
<link rel="icon" href="/brand/logo-64.png">
<style>
  :root {
    --page: #0f1115; --panel: #161a20; --card: #1d222a; --card-hover: #232a33; --border: #2a313b;
    --text: #e6e8eb; --muted: #8b919c; --faint: #5d6470; --gold: #e0a83a; --gold-dim: #8a6420;
    --green: #3fb96b; --green-dim: #1f5c37; --red: #e05a52; --blue: #5fb3f0; --radius: 10px;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; background: var(--page); color: var(--text);
    font: 14px/1.4 "Segoe UI", system-ui, sans-serif; overflow: hidden; }
  button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; }
  input { font: inherit; color: var(--text); background: var(--page); border: 1px solid var(--border);
    border-radius: 8px; padding: 9px 12px; outline: none; }
  input:focus { border-color: var(--gold-dim); }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-thumb { background: #2b323d; border-radius: 5px; border: 2px solid var(--page); }

  /* layout */
  .app { display: grid; grid-template-rows: 64px 1fr; height: 100vh; }
  header { display: flex; align-items: center; gap: 16px; padding: 0 20px; background: var(--panel);
    border-bottom: 1px solid var(--border); }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: .06em; }
  .brand img { width: 30px; height: 30px; }
  .brand .name { color: var(--gold); font-size: 16px; }
  .who { color: var(--muted); font-weight: 400; letter-spacing: 0; }
  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px;
    font-size: 12px; background: #1b2028; color: var(--muted); border: 1px solid var(--border); }
  .pill .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--faint); }
  .pill.on { color: #7fdca2; border-color: var(--green-dim); }
  .pill.on .dot { background: var(--green); box-shadow: 0 0 8px var(--green); }
  .pill.off { color: #f0938d; border-color: #5c2a27; }
  .pill.off .dot { background: var(--red); }
  .spacer { flex: 1; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 8px;
    background: var(--card); border: 1px solid var(--border); transition: background .15s, border-color .15s; }
  .btn:hover { background: var(--card-hover); border-color: #3a4350; }
  .btn img { width: 16px; height: 16px; }
  .btn.primary { background: var(--green); border-color: var(--green); color: #07140c; font-weight: 600; }
  .btn.primary:hover { background: #4fcc7c; }
  .btn.gold { background: var(--gold); border-color: var(--gold); color: #1a1205; font-weight: 600; }
  .btn.gold:hover { background: #f0b84a; }
  .btn.danger:hover { border-color: var(--red); color: #f0938d; }
  .btn.small { padding: 5px 10px; font-size: 13px; }
  .btn:disabled { opacity: .45; cursor: default; }
  .icon-btn { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 8px; }
  .icon-btn:hover { background: #2a313b; }
  .icon-btn img { width: 18px; height: 18px; }

  .body { display: grid; grid-template-columns: 340px 1fr; min-height: 0; }
  aside { background: var(--panel); border-right: 1px solid var(--border); display: flex; flex-direction: column;
    min-height: 0; }
  .aside-scroll { flex: 1; overflow: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .section-title { display: flex; justify-content: space-between; align-items: baseline; color: var(--muted);
    font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; margin: 4px 2px 2px; }

  /* character cards */
  .char { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px;
    cursor: pointer; transition: border-color .15s, background .15s; position: relative; }
  .char:hover { background: var(--card-hover); }
  .char.selected { border-color: var(--gold-dim); box-shadow: 0 0 0 1px var(--gold-dim) inset; }
  .char.locked { opacity: .55; }
  .char .top { display: flex; align-items: center; gap: 10px; }
  .avatar { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-weight: 700;
    color: #0f1115; flex: none; position: relative; }
  .avatar .status { position: absolute; right: -1px; bottom: -1px; width: 12px; height: 12px; border-radius: 50%;
    border: 2px solid var(--card); background: var(--faint); }
  .avatar .status.online { background: var(--green); }
  .avatar .status.error { background: var(--red); }
  .char .name { font-weight: 600; font-size: 15px; }
  .chip { font-size: 11px; padding: 1px 7px; border-radius: 999px; background: #262c36; color: var(--muted); }
  .chip.main { background: #3a2c12; color: var(--gold); }
  .char .meta { font-size: 12px; color: var(--muted); }
  .char .doing { margin-top: 8px; font-size: 12.5px; color: #7fdca2; white-space: nowrap; overflow: hidden;
    text-overflow: ellipsis; }
  .bar { height: 5px; border-radius: 3px; background: #2a313b; overflow: hidden; }
  .bar > div { height: 100%; background: var(--green); border-radius: 3px; transition: width .4s; }
  .char .stats { display: grid; grid-template-columns: 1fr auto; gap: 6px 10px; align-items: center; margin-top: 10px;
    font-size: 12px; color: var(--muted); }
  .char .actions { display: flex; gap: 6px; margin-top: 10px; }
  .running { display: flex; align-items: center; gap: 8px; margin-top: 10px; padding: 7px 9px; border-radius: 8px;
    background: #15291d; border: 1px solid var(--green-dim); font-size: 12.5px; }
  .running .time { color: var(--muted); margin-left: auto; font-variant-numeric: tabular-nums; }
  .clone-card { background: linear-gradient(135deg, #221a0c, var(--card)); border: 1px solid #3a2c12;
    border-radius: var(--radius); padding: 14px; }
  .clone-card .big { font-size: 22px; font-weight: 700; color: var(--gold); }
  .toggle { display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 13px; color: var(--muted);
    user-select: none; }
  .switch { width: 34px; height: 19px; border-radius: 999px; background: #2a313b; position: relative; transition: .2s; }
  .switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 15px; height: 15px; border-radius: 50%;
    background: #9aa1ab; transition: .2s; }
  .toggle.on .switch { background: var(--green-dim); }
  .toggle.on .switch::after { left: 17px; background: var(--green); }

  /* main area */
  main { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .tabs { display: flex; gap: 4px; padding: 10px 20px 0; border-bottom: 1px solid var(--border); background: var(--page); }
  .tab { padding: 9px 14px 11px; color: var(--muted); border-bottom: 2px solid transparent; font-weight: 500; }
  .tab:hover { color: var(--text); }
  .tab.active { color: var(--text); border-bottom-color: var(--gold); }
  .tab .count { font-size: 11px; color: var(--faint); margin-left: 4px; }
  .view { flex: 1; min-height: 0; overflow: auto; padding: 20px; display: none; }
  .view.active { display: block; }
  .view.flush { padding: 0; }
  .toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
  .toolbar input { width: 280px; }
  .hint { color: var(--muted); font-size: 13px; }

  .section-head { grid-column: 1/-1; display: flex; align-items: center; gap: 10px; margin: 6px 0 -2px; }
  .section-head:not(:first-child) { margin-top: 18px; }
  .section-head h3 { margin: 0; font-size: 14px; font-weight: 600; letter-spacing: .02em; }
  .section-head .count { background: var(--card); border: 1px solid var(--border); border-radius: 999px;
    padding: 1px 8px; font-size: 11.5px; color: var(--muted); }
  .section-head .sub { color: var(--muted); font-size: 12px; flex: 1; }
  .section-empty { grid-column: 1/-1; color: var(--muted); font-size: 13px; padding: 18px; text-align: center;
    border: 1px dashed var(--border); border-radius: var(--radius); }
  /* scripts */
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .script { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px;
    display: flex; flex-direction: column; gap: 10px; transition: border-color .15s, transform .15s; }
  .script:hover { border-color: #3a4350; transform: translateY(-1px); }
  .script.is-running { border-color: var(--green-dim); background: linear-gradient(180deg, #15291d, var(--card) 60%); }
  .script .head { display: flex; align-items: center; gap: 10px; }
  .script .head img { width: 30px; height: 30px; image-rendering: pixelated; }
  .badge { width: 36px; height: 36px; border-radius: 9px; display: grid; place-items: center; background: #232a33; flex: none; }
  .script .title { font-weight: 600; font-size: 15px; }
  .script .desc { color: var(--muted); font-size: 12.5px; min-height: 34px; display: -webkit-box;
    -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .script .row { display: flex; gap: 8px; margin-top: auto; }
  .run-btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 8px;
    border: 1px solid var(--green-dim); color: #7fdca2; font-weight: 600; font-size: 13px; }
  .run-btn:hover { background: #15291d; }
  .run-btn img { width: 14px; height: 14px; }
  .stop-btn { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 8px;
    border: 1px solid #5c2a27; color: #f0938d; font-weight: 600; font-size: 13px; }
  .stop-btn:hover { background: #2a1513; }
  .stop-btn img { width: 12px; height: 12px; }

  /* output */
  .console { font: 12.5px/1.55 "Cascadia Mono", Consolas, monospace; background: #0b0d10; border: 1px solid var(--border);
    border-radius: var(--radius); padding: 12px 14px; height: calc(100% - 52px); overflow: auto; white-space: pre-wrap; }
  .console .t { color: var(--faint); }
  .console .w { font-weight: 700; }
  .console .error { color: var(--red); }
  .console .start { color: var(--gold); }
  .console .stop { color: var(--muted); }
  .filter { padding: 4px 10px; border-radius: 999px; border: 1px solid var(--border); font-size: 12px; color: var(--muted); }
  .filter.on { color: var(--text); border-color: var(--gold-dim); background: #221a0c; }

  /* skills */
  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
  .skill { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 12px;
    display: grid; grid-template-columns: 28px 1fr auto; gap: 4px 10px; align-items: center; }
  .skill img { width: 25px; height: 25px; image-rendering: pixelated; grid-row: span 2; }
  .skill .lvl { font-weight: 700; font-size: 18px; color: var(--gold); }
  .skill .bar { grid-column: 2 / 4; }
  .skill .bar > div { background: var(--gold); }

  /* character view */
  #skills > .cats { margin-bottom: 14px; }
  .filter .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
  .who-card { display: flex; align-items: center; gap: 18px; background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 12px 16px; margin-bottom: 16px; flex-wrap: wrap; }
  .who-card .avatar .status { border-color: var(--card); }
  .who-main b { display: block; font-size: 16px; }
  .who-main span { color: var(--muted); font-size: 12.5px; }
  .kv span { display: block; color: var(--muted); font-size: 11.5px; text-transform: uppercase; letter-spacing: .06em; }
  .kv b { font-size: 17px; font-variant-numeric: tabular-nums; }
  .kv b.gold { color: var(--gold); }
  .char-layout { display: grid; grid-template-columns: 1fr 292px; gap: 18px; align-items: start; }
  .char-layout.no-side { grid-template-columns: 1fr; }
  .char-layout .section-head { margin: 0 0 10px; }
  .char-layout .training + .section-head { margin-top: 20px; }
  .training { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 10px; }
  .train { display: flex; gap: 12px; align-items: center; background: linear-gradient(135deg, #221a0c, var(--card) 70%);
    border: 1px solid #3a2c12; border-radius: var(--radius); padding: 12px 14px; }
  .train.fresh { border-color: var(--gold-dim); box-shadow: 0 0 0 1px #8a642055 inset; }
  .train > img { width: 30px; height: 30px; image-rendering: pixelated; }
  .t-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .t-top { display: flex; align-items: baseline; gap: 8px; }
  .t-top .lvl { font-weight: 700; color: var(--gold); font-size: 16px; }
  .train .bar > div { background: var(--gold); }
  .t-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 10px; font-size: 12px; color: var(--muted);
    font-variant-numeric: tabular-nums; }
  .t-stats b { color: var(--text); }
  .skill.trained { border-color: #3a2c12; }
  .skill .rate { font-size: 11px; color: var(--gold); }
  .skill .lvl .up { color: var(--green); } .skill .lvl .down { color: var(--red); }
  .skill .lvl .of { color: var(--muted); font-size: 13px; font-weight: 600; }
  .side { display: flex; flex-direction: column; gap: 14px; position: sticky; top: 0; }
  .panel { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; }
  .panel-title { display: flex; justify-content: space-between; color: var(--muted); font-size: 12px; font-weight: 600;
    letter-spacing: .08em; text-transform: uppercase; margin-bottom: 10px; }
  .panel-title span { letter-spacing: 0; font-weight: 400; }
  .worn { display: grid; grid-template-columns: repeat(3, 52px); gap: 6px; justify-content: center; }
  .inv { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; }
  .slot { height: 48px; border-radius: 8px; background: #161a20; border: 1px solid #262c36; position: relative;
    display: grid; place-items: center; }
  .worn .slot { height: 52px; }
  .slot img { max-width: 34px; max-height: 30px; image-rendering: pixelated; }
  .slot img.ph { opacity: .18; filter: grayscale(1); }
  .slot .n { position: absolute; left: 4px; top: 1px; font: 700 11.5px "Segoe UI"; color: #ffff00; text-shadow: 1px 1px 0 #000; }
  .slot .n.k { color: #fff; } .slot .n.m { color: #00ff80; }
  .slot[data-name]:hover { border-color: #3a4350; }
  .slot[data-name]:hover::after { content: attr(data-name); position: absolute; bottom: calc(100% + 4px); left: 50%;
    transform: translateX(-50%); background: #000d; padding: 3px 8px; border-radius: 6px; font-size: 12px; white-space: nowrap; z-index: 3; }
  @media (max-width: 1100px) { .char-layout { grid-template-columns: 1fr; } .side { position: static; flex-direction: row; flex-wrap: wrap; } }

  /* bank */
  .bank { display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 6px; }
  .item { background: var(--card); border: 1px solid var(--border); border-radius: 8px; height: 64px; position: relative;
    display: grid; place-items: center; }
  .item img { max-width: 36px; max-height: 32px; image-rendering: pixelated; }
  .item .n { position: absolute; left: 5px; top: 2px; font: 700 12px "Segoe UI"; color: #ffff00; text-shadow: 1px 1px 0 #000; }
  .item .n.k { color: #fff; } .item .n.m { color: #00ff80; }
  .item:hover::after { content: attr(data-name); position: absolute; bottom: calc(100% + 4px); left: 50%;
    transform: translateX(-50%); background: #000d; padding: 3px 8px; border-radius: 6px; font-size: 12px; white-space: nowrap; z-index: 2; }

  /* highscores */
  .skill-picker { display: flex; flex-wrap: wrap; gap: 4px; }
  .skill-picker button { width: 34px; height: 34px; border-radius: 8px; display: grid; place-items: center;
    border: 1px solid transparent; }
  .skill-picker button:hover { background: var(--card); }
  .skill-picker button.on { background: #221a0c; border-color: var(--gold-dim); }
  .skill-picker img { width: 21px; height: 21px; image-rendering: pixelated; }
  table.hs { width: 100%; max-width: 900px; border-collapse: collapse; }
  .hs th { text-align: left; color: var(--muted); font-weight: 600; font-size: 12px; text-transform: uppercase;
    letter-spacing: .06em; padding: 8px 12px; border-bottom: 1px solid var(--border); }
  .hs td { padding: 10px 12px; border-bottom: 1px solid #1d222a; }
  .hs tr:hover td { background: var(--card); }
  .hs tr.me td { background: #221a0c; }
  .hs .rank { color: var(--muted); width: 60px; font-variant-numeric: tabular-nums; }
  .hs .num { text-align: right; font-variant-numeric: tabular-nums; }
  .hs .medal { font-weight: 700; color: var(--gold); }
  iframe { width: 100%; height: 100%; border: 0; display: block; background: #000; }

  /* empty states and setup */
  .empty { display: grid; place-items: center; text-align: center; color: var(--muted); padding: 60px 20px; gap: 10px; }
  .empty img { width: 240px; opacity: .9; }
  .empty h3 { margin: 0; color: var(--text); font-size: 17px; }
  .setup { position: fixed; inset: 0; z-index: 50; display: none; place-items: center;
    background: linear-gradient(90deg, #0f1115ee 0%, #0f111599 45%, #0f111522 100%),
                url("/ui/hero.png") center / cover no-repeat, #0f1115; }
  .setup.show { display: grid; }
  .setup .box { width: 460px; background: var(--panel); border: 1px solid var(--border); border-radius: 14px; padding: 28px; }
  .setup h2 { margin: 0 0 4px; }
  .setup label { display: block; font-size: 12px; color: var(--muted); margin: 14px 0 6px; }
  .setup input { width: 100%; }
  .error-text { color: #f0938d; font-size: 13px; min-height: 18px; margin-top: 10px; }
  .settings { max-width: 560px; display: flex; flex-direction: column; gap: 14px; }
  .settings .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; }
  .settings h4 { margin: 0 0 10px; }
  .toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%) translateY(20px); opacity: 0;
    background: #1d222a; border: 1px solid var(--border); padding: 10px 16px; border-radius: 10px; transition: .25s; z-index: 60; }
  .toast.show { opacity: 1; transform: translateX(-50%); }

  /* right-click menus (characters and scripts) */
  .ctx { position: fixed; z-index: 80; min-width: 230px; max-width: 300px; padding: 6px; border-radius: 10px;
    background: #1a1f26; border: 1px solid #343c48; box-shadow: 0 12px 32px #000a, 0 0 0 1px #0006;
    font-size: 13.5px; opacity: 0; transform: scale(.97); transform-origin: top left;
    transition: opacity .1s, transform .1s; outline: none; }
  .ctx.show { opacity: 1; transform: none; }
  .ctx .ctx-head { display: flex; align-items: center; gap: 10px; padding: 6px 8px 9px; margin-bottom: 4px;
    border-bottom: 1px solid var(--border); }
  .ctx .ctx-head .avatar { width: 28px; height: 28px; font-size: 13px; }
  .ctx .ctx-head .avatar .status { width: 10px; height: 10px; border-color: #1a1f26; }
  .ctx .ctx-head b { display: block; font-size: 14px; }
  .ctx .ctx-head span { color: var(--muted); font-size: 12px; }
  .ctx-item { display: flex; align-items: center; gap: 10px; width: 100%; padding: 7px 9px; border-radius: 7px;
    text-align: left; white-space: nowrap; position: relative; }
  .ctx-item:hover, .ctx-item.open, .ctx-item:focus-visible { background: #262d37; outline: none; }
  .ctx-item .ico { width: 18px; height: 18px; display: grid; place-items: center; flex: none; }
  .ctx-item .ico img { max-width: 18px; max-height: 18px; image-rendering: pixelated; }
  .ctx-item .label { flex: 1; overflow: hidden; text-overflow: ellipsis; }
  .ctx-item .kbd { color: var(--faint); font-size: 12px; }
  .ctx-item .arrow { color: var(--muted); font-size: 11px; }
  .ctx-item.green { color: #7fdca2; }
  .ctx-item.red { color: #f0938d; }
  .ctx-item.red:hover { background: #2a1513; }
  .ctx-item.gold { color: var(--gold); }
  .ctx-item:disabled { opacity: .4; cursor: default; background: none; }
  .ctx-item.running::after { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--green);
    box-shadow: 0 0 6px var(--green); }
  .ctx-sep { height: 1px; background: var(--border); margin: 5px 4px; }
  .ctx-label { color: var(--faint); font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    padding: 6px 9px 3px; }
  .ctx input.ctx-search { width: 100%; padding: 6px 9px; margin-bottom: 4px; font-size: 13px; }
  .ctx .ctx-scroll { max-height: min(420px, 70vh); overflow: auto; }
  .ctx .ctx-none { color: var(--muted); padding: 8px 9px; font-size: 12.5px; }
  .char .more { opacity: 0; transition: opacity .15s; }
  .char:hover .more, .char .more.open { opacity: 1; }
  .more-dots { font-size: 18px; line-height: 1; color: var(--muted); letter-spacing: 1px; }
  .cats { display: flex; gap: 6px; flex-wrap: wrap; }
</style>
</head>
<body>
<div class="app">
  <header>
    <div class="brand"><img id="logo" src="/family-32.png" alt=""><span class="name">BOT SCAPE</span>
      <span class="who" id="mainName"></span></div>
    <span class="pill" id="serverPill"><span class="dot"></span><span id="serverText">Connecting…</span></span>
    <div class="spacer"></div>
    <button class="btn" id="folderBtn" title="Open the scripts folder"><img src="/open-client-16.png" alt="">Scripts folder</button>
    <button class="btn primary" id="clientBtn"><img src="/play-16.png" alt="" style="filter:brightness(0)">Play</button>
  </header>
  <div class="body">
    <aside>
      <div class="aside-scroll">
